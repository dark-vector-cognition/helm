{
  "name": "hydra",
  "version": "2.1.0",
  "description": "HYDRA — Mission control dashboard for system processes, ports, AI agents, and git repos",
  "main": "./out/main/index.js",
  "author": "kunalnano",
  "homepage": "https://github.com/kunalnano/hydra",
  "scripts": {
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 -s",
    "rebuild:node": "npm rebuild better-sqlite3",
    "predev": "npm run rebuild:electron 2>/dev/null || true",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "pretest": "npm run rebuild:node 2>/dev/null || true",
    "test": "vitest run",
    "pretest:watch": "npm run rebuild:node 2>/dev/null || true",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "react-resizable-panels": "^4.7.1",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^18.19.9",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.2",
    "electron-vite": "^3.1.0",
    "prettier": "^3.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
