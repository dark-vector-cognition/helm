{
  "name": "helm",
  "version": "5.0.0",
  "description": "HELM: Operator shell for local AI systems, processes, ports, and git repos",
  "main": "./out/main/index.js",
  "author": "Dark Vector Cognition LLC",
  "homepage": "https://github.com/dark-vector-cognition/helm",
  "repository": {
    "type": "git",
    "url": "https://github.com/dark-vector-cognition/helm.git"
  },
  "bugs": {
    "url": "https://github.com/dark-vector-cognition/helm/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3 -s",
    "rebuild:node": "npm rebuild better-sqlite3",
    "predev": "npm run rebuild:electron 2>/dev/null || true",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "pretest": "npm run rebuild:node 2>/dev/null || true",
    "test": "vitest run",
    "pretest:watch": "npm run rebuild:node 2>/dev/null || true",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/topojson-client": "^3.1.5",
    "better-sqlite3": "^12.11.1",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.3.1",
    "react-resizable-panels": "^4.7.1",
    "tailwindcss": "^4.1.18",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.0",
    "electron-vite": "^3.1.0",
    "prettier": "^3.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
