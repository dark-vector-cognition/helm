# HELM local overrides
# Copy this file to `.env` from the repo root. Every path below may be:
# - absolute (`/home/me/dev/repos`)
# - home-relative (`~/dev/repos`)
# - repo-relative (`./reports/helm-scan-report.md`)

# Optional model endpoint for AI briefings. Any OpenAI-compatible server works
# (LM Studio, Ollama, llama.cpp). Leave this unset to run HELM with no model:
# every page still works and briefings simply stay off.
# LM_STUDIO_URL=http://localhost:1234

# Optional API key for a hosted OpenAI-compatible endpoint. Leave empty for local servers.
# Sent as `Authorization: Bearer <key>` only to the LM_STUDIO_URL endpoint above, so it works only
# together with LM_STUDIO_URL and is ignored without it. Overrides `apiKey` in
# ~/.config/helm/config.json. Never commit a real key.
# LLM_API_KEY=

# Repo discovery roots for the Fleet page.
# Default behavior without this override: HELM scans the current clone when run from the repo root.
# HELM_GIT_REPO_PATHS=.

# Optional external agent state directories (`*.state.json`, `*.trace.jsonl`).
# HELM_AGENT_FEED_PATHS=~/.config/helm/agents

# Optional extra log files or glob patterns to watch.
# HELM_LOG_FILE_PATHS=~/.claude/projects/*/logs/*.log,./logs/*.log

# Optional firewall rule parser override (macOS LuLu).
# HELM_LULU_PARSER_PATH=./src/main/monitors/lulu-parser.py

# Optional Sentinel overrides.
# HELM_SENTINEL_CONFIG_PATH=./src/main/sentinel/config.json
# HELM_SENTINEL_VAULT_LOG_DIR=./logs/sentinel
# HELM_SENTINEL_SLACK_WEBHOOK=
# HELM_SENTINEL_MACOS_NOTIFICATIONS=true
# HELM_SENTINEL_VAULT_LOG_ENABLED=true
# HELM_SENTINEL_POLL_INTERVAL_MS=30000

# Optional Codex skills root used by the skill activity feed.
# HELM_SKILLS_ROOT=~/.codex/skills

# Optional HIVE overrides.
# HELM_HIVE_ENABLED=false
# HELM_HIVE_SHARED_CONTEXT_PATH=./.helm/hive/shared/context.md
# HELM_HIVE_CLAUDE_BIN_PATH=claude
# HELM_HIVE_SESSION_PREFIX=helm-hive
# HELM_HIVE_IDLE_RECLAIM_MINUTES=30

# Polling intervals in milliseconds.
# HELM_MONITOR_INTERVAL_MS=2000
# HELM_SNAPSHOT_INTERVAL_MS=30000
